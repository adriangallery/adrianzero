# Builder Battle Environment Variables
# Copy this file to .env.local and fill in your values

# Admin addresses (comma-separated)
ADMIN_ADDRESSES=0x4943407105999e3E97EFA2035F5cbC64D72581C6

# API Configuration
API_BASE_URL=/api/votes

# Supabase Configuration (for data persistence)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# GitHub API Configuration (alternative - not needed with Supabase)
# GITHUB_TOKEN=your_github_personal_access_token_here

# Database Configuration (if using external DB)
# DATABASE_URL=your_database_url_here

# Security
# JWT_SECRET=your_jwt_secret_here
