  assets/game/opcodes.json

  {
    "version": 1,
    "purpose": "Defines the allowed script operations (opcodes) for AdrianAdventure. The engine must only execute these ops and ignore/throw on unknown ops.",
    "conventions": {
      "script": "An array of operations executed in order.",
      "text": "UI dialogue line shown to the player (subtitle style).",
      "flags": "Boolean or small primitive values stored in GameState.flags.",
      "inventory": "Array of itemIds stored in GameState.inventory.",
      "web3": "Read-only checks based on wallet connection state + provider calls."
    },
    "ops": [
      {
        "op": "say",
        "desc": "Display a dialogue line in the UI log/subtitles.",
        "payload": {
          "text": "string"
        },
        "example": { "op": "say", "text": "Something feels off." }
      },
      {
        "op": "setFlag",
        "desc": "Set a flag value in game state.",
        "payload": {
          "flag": "string",
          "value": "boolean | number | string | null"
        },
        "example": { "op": "setFlag", "flag": "door_unlocked", "value": true }
      },
      {
        "op": "ifFlag",
        "desc": "Branch based on a flag value. Truthy = then, falsy = else.",
        "payload": {
          "flag": "string",
          "then": "script[]",
          "else": "script[]"
        },
        "example": {
          "op": "ifFlag",
          "flag": "drawer_opened",
          "then": [{ "op": "say", "text": "Already open." }],
          "else": [{ "op": "setFlag", "flag": "drawer_opened", "value": true }]
        }
      },
      {
        "op": "addItem",
        "desc": "Add an item to inventory (if not present) unless stackable logic exists.",
        "payload": {
          "itemId": "string"
        },
        "example": { "op": "addItem", "itemId": "itm_rusty_key" }
      },
      {
        "op": "removeItem",
        "desc": "Remove an item from inventory if present.",
        "payload": {
          "itemId": "string"
        },
        "example": { "op": "removeItem", "itemId": "itm_old_note" }
      },
      {
        "op": "selectVerb",
        "desc": "Force-select a verb in UI (optional convenience).",
        "payload": {
          "verbId": "string"
        },
        "example": { "op": "selectVerb", "verbId": "LOOK" }
      },
      {
        "op": "selectItem",
        "desc": "Force-select an inventory item (or clear selection with null).",
        "payload": {
          "itemId": "string | null"
        },
        "example": { "op": "selectItem", "itemId": "itm_rusty_key" }
      },
      {
        "op": "clearSelection",
        "desc": "Clear selected verb back to WALK and clear selected item.",
        "payload": {},
        "example": { "op": "clearSelection" }
      },
      {
        "op": "gotoScene",
        "desc": "Transition to another scene and optionally set player spawn position.",
        "payload": {
          "sceneId": "string",
          "spawn": { "x": "number", "y": "number" }
        },
        "example": { "op": "gotoScene", "sceneId": "front_door", "spawn": { "x": 540, "y": 1040 } }
      },
      {
        "op": "queueScript",
        "desc": "Append another script by id (useful for reuse).",
        "payload": {
          "scriptId": "string"
        },
        "example": { "op": "queueScript", "scriptId": "scr_intro_glitch" }
      },
      {
        "op": "ifItemSelected",
        "desc": "Branch if the currently selected inventory item matches itemId.",
        "payload": {
          "itemId": "string",
          "then": "script[]",
          "else": "script[]"
        },
        "example": {
          "op": "ifItemSelected",
          "itemId": "itm_rusty_key",
          "then": [{ "op": "setFlag", "flag": "door_unlocked", "value": true }],
          "else": [{ "op": "say", "text": "I need a key." }]
        }
      },
      {
        "op": "requireItem",
        "desc": "Gate a script: if player lacks item, show message and stop execution.",
        "payload": {
          "itemId": "string",
          "onFail": "script[]"
        },
        "example": {
          "op": "requireItem",
          "itemId": "itm_rusty_key",
          "onFail": [{ "op": "say", "text": "I don’t have that." }]
        }
      },
      {
        "op": "ifWeb3Connected",
        "desc": "Branch based on wallet connection state.",
        "payload": {
          "then": "script[]",
          "else": "script[]"
        },
        "example": {
          "op": "ifWeb3Connected",
          "then": [{ "op": "say", "text": "Wallet connected." }],
          "else": [{ "op": "say", "text": "CONNECT WALLET." }]
        }
      },
      {
        "op": "web3Require",
        "desc": "Hard gate: if not connected, run onFail and stop script.",
        "payload": {
          "onFail": "script[]"
        },
        "example": {
          "op": "web3Require",
          "onFail": [{ "op": "say", "text": "You must connect a wallet to do that." }]
        }
      },
      {
        "op": "web3CheckERC721",
        "desc": "Async check: does the connected wallet own >= minBalance of an ERC721 collection? Sets a flag with the result.",
        "payload": {
          "chainId": "number",
          "contract": "string",
          "minBalance": "number",
          "setFlag": "string",
          "onError": "script[]"
        },
        "example": {
          "op": "web3CheckERC721",
          "chainId": 8453,
          "contract": "0xYourErc721AddressHere",
          "minBalance": 1,
          "setFlag": "has_adrianpunks",
          "onError": [{ "op": "say", "text": "Couldn’t verify ownership right now." }]
        }
      },
      {
        "op": "web3CheckERC20",
        "desc": "Async check: does the connected wallet have >= minBalance (human units) of an ERC20? Sets a flag with the result.",
        "payload": {
          "chainId": "number",
          "contract": "string",
          "minBalance": "string",
          "decimals": "number | null",
          "setFlag": "string",
          "onError": "script[]"
        },
        "example": {
          "op": "web3CheckERC20",
          "chainId": 8453,
          "contract": "0xYourErc20AddressHere",
          "minBalance": "1000",
          "decimals": null,
          "setFlag": "has_adrian_tokens",
          "onError": [{ "op": "say", "text": "Token check failed." }]
        }
      },
      {
        "op": "stop",
        "desc": "Stop executing the current script immediately.",
        "payload": {},
        "example": { "op": "stop" }
      }
    ],
    "scriptLibrary": {
      "version": 1,
      "scripts": [
        {
          "id": "scr_generic_locked",
          "script": [
            { "op": "say", "text": "Locked. Of course." }
          ]
        },
        {
          "id": "scr_need_wallet",
          "script": [
            { "op": "say", "text": "CONNECT WALLET." }
          ]
        }
      ]
    },
    "engine_requirements": {
      "strictMode": true,
      "unknownOpBehavior": "throw",
      "asyncOps": ["web3CheckERC721", "web3CheckERC20"],
      "asyncPolicy": {
        "sequential": true,
        "timeoutMs": 8000,
        "onTimeout": [{ "op": "say", "text": "Request timed out." }]
      }
    }
  }

