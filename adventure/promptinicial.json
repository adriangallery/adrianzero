Scene JSON schema (formato recomendado)

Archivo: assets/scenes/<sceneId>/scene.json

{
    "version": 1,
    "id": "suburban_street",
    "title": "Suburban Street",
    "assets": {
      "background": "background.png",
      "walkmask": "walkmask.png",
      "atlas": null
    },
    "render": {
      "world": { "width": 2400, "height": 1350 },
      "camera": {
        "start": { "x": 600, "y": 675 },
        "followPlayer": true,
        "lerp": 0.12,
        "clampToWorld": true
      }
    },
    "player": {
      "spawn": { "x": 520, "y": 1020 },
      "speed": 280,
      "sprite": {
        "sheet": null,
        "idle": null,
        "walk": null
      }
    },
    "ui": {
      "verbs": ["LOOK", "USE", "TALK", "PICK", "OPEN", "CLOSE"],
      "mobileDrawerDefault": "collapsed"
    },
    "maskMapping": {
      "walkableColor": "#0000FF",
      "hotspotColor": "#FFFF00",
      "triggerColor": "#FF00FF",
      "regionIdStrategy": "manual"
    },
    "regions": {
      "hotspots": [
        {
          "id": "hs_mailbox",
          "maskRegionId": "hs_mailbox",
          "name": "Mailbox",
          "cursor": "pointer",
          "scripts": {
            "LOOK": [],
            "USE": [],
            "TALK": [],
            "PICK": [],
            "OPEN": [],
            "CLOSE": []
          }
        }
      ],
      "triggers": [
        {
          "id": "tr_to_frontdoor",
          "maskRegionId": "tr_to_frontdoor",
          "once": false,
          "onEnter": []
        }
      ]
    },
    "items": {
      "sceneItems": [
        {
          "id": "itm_rusty_key",
          "name": "Rusty Key",
          "icon": "ui/items/rusty_key.png",
          "spawn": { "type": "hotspot", "hotspotId": "hs_doormat" },
          "pickup": {
            "enabled": true,
            "verb": "PICK",
            "onPickup": []
          }
        }
      ]
    },
    "combos": [
      {
        "a": "itm_rusty_key",
        "b": "itm_old_note",
        "result": "itm_note_with_code",
        "script": []
      }
