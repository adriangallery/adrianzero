{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/show",
      "dest": "/SHOW/index.html"
    },
    {
      "src": "/show/(.*)",
      "dest": "/SHOW/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
