# Vercel Environment Variables Configuration
# Set these variables in your Vercel dashboard under Settings > Environment Variables

# Contract Configuration
CONTRACT_ADDRESS=0x90546848474fb3c9fda3fdad887969bb244e7e58
SHOOTER_CONTRACT=0xea1d57fa135b661dd77fb7187e6b366c25fd085f
ADMIN_WALLET=0x4943407105999e3E97EFA2035F5cbC64D72581C6

# Network Configuration
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Backend Signer (IMPORTANT: Set this in Vercel dashboard as a secret)
# This should be a private key for a dedicated backend signer wallet
BACKEND_SIGNER_KEY=your_backend_signer_private_key_here

# Server Configuration
NODE_ENV=production

# CORS Configuration (adjust for your domain)
CORS_ORIGIN=https://your-vercel-domain.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
