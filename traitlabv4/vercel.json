{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "redirects": [
    { "source": "/adventure", "destination": "https://adventure.adrianzero.com/", "permanent": false },
    { "source": "/adventure/", "destination": "https://adventure.adrianzero.com/", "permanent": false },
    { "source": "/adventure/:path+", "destination": "https://adventure.adrianzero.com/:path+", "permanent": false },
    { "source": "/shooter", "destination": "/zombie", "permanent": true },
    { "source": "/shooter/:path*", "destination": "/zombie", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
