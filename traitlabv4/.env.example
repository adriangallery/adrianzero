# Alchemy API Keys
# Get your free API key at: https://www.alchemy.com/
# Free tier: 300M compute units/month (plenty for this app)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Fallback Alchemy key used when the primary key is rate-limited
VITE_ALCHEMY_API_KEY_FALLBACK=your_backup_alchemy_api_key_here

# Optional: Multiple fallback keys (comma-separated)
# VITE_ALCHEMY_API_KEYS=key_one,key_two,key_three

# Optional: Infura API Key (fallback)
VITE_INFURA_API_KEY=cc0c8013b1e044dcba79d4f7ec3b2ba1

# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Vercel API URL for image rendering (if using custom endpoint)
VITE_VERCEL_API_URL=https://adrianlab.vercel.app/api
