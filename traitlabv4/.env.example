# Alchemy API Keys — https://www.alchemy.com/ (free tier: 300M compute units/month)
VITE_ALCHEMY_API_KEY=

# Alchemy API Key for ENS resolution (Ethereum Mainnet)
VITE_ALCHEMY_ENS_KEY=

# Optional: Fallback Alchemy key used when the primary key is rate-limited
VITE_ALCHEMY_API_KEY_FALLBACK=

# Optional: Multiple fallback keys (comma-separated), tried before the two above
VITE_ALCHEMY_API_KEYS=

# Optional: Infura API Key (RPC fallback). If unset, this endpoint is skipped —
# no hardcoded default (see src/config/alchemy.ts).
VITE_INFURA_API_KEY=

# WalletConnect Project ID — https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Generic API base URL(s) used by a few features
VITE_BUDOKAI_API_URL=

# AdrianLAB API base URL — client: src/lib/adrianlab.ts (F9, 13-sep-2026).
# Optional: fallback is https://adrianlab.vercel.app when unset (current prod
# behaviour). If set, it MUST be the bare origin WITHOUT a trailing /api —
# the client appends /api/render, /api/metadata, /labimages, etc. itself.
VITE_VERCEL_API_URL=

# Buy $ZERO — Swap contract addresses (Base mainnet, public addresses, not secret)
VITE_SWAP_ROUTER_ADDRESS=
VITE_V4_QUOTER_ADDRESS=
VITE_HOOK_ADDRESS=
VITE_WETH_ADDRESS=
VITE_POOL_ADDRESS=
VITE_SWAP_DIAMOND_ADDRESS=
