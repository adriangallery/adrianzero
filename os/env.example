# Configuración de variables de entorno para AdrianLAB OpenSea Integration

# API Key de OpenSea (obligatoria)
# Obtén tu API key en: https://docs.opensea.io/reference/api-overview
OPENSEA_API_KEY=your_opensea_api_key_here

# Configuración opcional
NODE_ENV=development
PORT=3000

# Configuración de la colección (opcional, se puede cambiar en config.js)
COLLECTION_CONTRACT_ADDRESS=0x90546848474FB3c9fda3fdAd887969bB244E7e58
COLLECTION_NAME=AdrianLAB
COLLECTION_WEBSITE=https://adrianzero.com

# Configuración de rate limiting (opcional)
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Configuración de UI (opcional)
ITEMS_PER_PAGE=20
MAX_RETRIES=3
RETRY_DELAY=1000
