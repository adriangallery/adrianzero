# Shooter Game Backend Configuration

# Contract Configuration
CONTRACT_ADDRESS=0x90546848474fb3c9fda3fdad887969bb244e7e58
SHOOTER_CONTRACT=0xea1d57fa135b661dd77fb7187e6b366c25fd085f
ADMIN_WALLET=0x4943407105999e3E97EFA2035F5cbC64D72581C6

# Network Configuration
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Backend Signer (for signing reward messages)
# IMPORTANT: This should be a dedicated wallet for the backend
# Never use the admin wallet for signing rewards
# This will be set from GitHub repository secrets
BACKEND_SIGNER_KEY=${BACKEND_SIGNER_KEY}

# Server Configuration
PORT=3001
NODE_ENV=development

# Security
CORS_ORIGIN=http://localhost:3000,https://adrianzero.com

# Database (optional - for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/shooter_game

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info